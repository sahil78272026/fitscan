# ============================================================
# FitScan Monorepo — Root .gitignore
# Covers: AI agents, secrets, OS junk, and build artifacts
# (each subproject has its own .gitignore for deeper rules)
# ============================================================

# ─── AI Agent & Teamwork Orchestration ────────────────────
.agents/
.agent/
_agents/
_agent/
PROJECT.md
AGENTS.md

# ─── Secrets & Credentials (never commit these) ───────────
.env
.env*
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.p8
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist
play-store-key.json
serviceAccount*.json
*secret*
*credentials*.json

# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.pytest_cache/
pytest.ini
.coverage
htmlcov/
.env*

# ─── Node / JS ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.*

# ─── Expo / React Native ──────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.orig.*
mobile/eas.json

# ─── Next.js / Frontend ───────────────────────────────────
.next/
out/
/build
/coverage

# ─── OS & Editor Junk ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.log
*.pdf

# ─── Telegram Bot Config (stores bot token locally) ───────
~/.gemini/antigravity-cli/telegram_bridge.json

# ─── Temporary / Scratch Scripts created by agents ────────
scripts/__pycache__/
scripts/test_m*.js
scripts/verify_m*.js
scripts/verify_m*.py
scripts/verify_proposed_*.py
scripts/benchmark_*.py
scripts/compare_*.py
scripts/convert_*.py
scripts/create_feature_*.py
scripts/resize_*.py
scripts/telegram_agent_bridge.py
scripts/
docs/
tests/