# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env and secret files
.env
.env_prod
play-store-key.json
*-key.json
*.json.secret

# Firebase secrets — use EAS Secrets instead (eas secret:create)
google-services.json
GoogleService-Info.plist

# EAS build config — contains env vars & key paths, use EAS Secrets
eas.json
# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
